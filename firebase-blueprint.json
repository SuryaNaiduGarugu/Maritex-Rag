{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile authenticated with Google Sign-In",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      },
      "required": ["userId", "email"]
    },
    "MaritimeProject": {
      "title": "MaritimeProject",
      "description": "Maritime Expo Project Record with Specs and Communications",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "code": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "maxLength": 64 },
        "vesselType": { "type": "string", "maxLength": 128 },
        "imoNumber": { "type": "string", "maxLength": 32 },
        "shipyard": { "type": "string", "maxLength": 128 },
        "client": { "type": "string", "maxLength": 128 },
        "contractValue": { "type": "number" },
        "status": { "type": "string", "maxLength": 64 },
        "progressPercent": { "type": "number" },
        "deliveryDate": { "type": "string", "maxLength": 32 },
        "technicalSpecs": { "type": "object" },
        "milestones": { "type": "array" },
        "keyRisks": { "type": "array" },
        "chatSources": { "type": "array" },
        "keywords": { "type": "array" },
        "summary": { "type": "string", "maxLength": 2048 },
        "expoBoothNumber": { "type": "string", "maxLength": 64 },
        "leadEngineer": { "type": "string", "maxLength": 128 },
        "lastUpdated": { "type": "string", "maxLength": 32 },
        "ownerId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "code", "name"]
    },
    "IngestionLog": {
      "title": "IngestionLog",
      "description": "Ingested WhatsApp or Audio transcription record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "sourceType": { "type": "string", "enum": ["WhatsApp", "AudioTranscription", "Slack", "Document"] },
        "rawContent": { "type": "string", "maxLength": 100000 },
        "extractedEntities": { "type": "object" },
        "confidence": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "sourceType"]
    },
    "RAGChatSession": {
      "title": "RAGChatSession",
      "description": "User RAG query or voice chat session",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "query": { "type": "string", "maxLength": 2048 },
        "response": { "type": "string", "maxLength": 8192 },
        "mode": { "type": "string", "enum": ["text", "voice"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "query", "response"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile"
    },
    "/projects/{projectId}": {
      "schema": "MaritimeProject",
      "description": "Shared and persisted maritime expo projects"
    },
    "/users/{userId}/ingestions/{ingestionId}": {
      "schema": "IngestionLog",
      "description": "User specific chat and audio ingestion history"
    },
    "/users/{userId}/chats/{chatId}": {
      "schema": "RAGChatSession",
      "description": "User specific RAG query and voice conversation history"
    }
  }
}
