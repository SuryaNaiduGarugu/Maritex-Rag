rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'garugusuryanaidu@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // USER PROFILES
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) &&
        request.resource.data.userId == userId &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 256;
      allow update: if isOwner(userId) &&
        request.resource.data.userId == userId;
      allow delete: if isOwner(userId) || isAdmin();

      // Subcollection: Ingestions
      match /ingestions/{ingestionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidId(ingestionId);
        allow update, delete: if isOwner(userId) || isAdmin();
      }

      // Subcollection: Chats
      match /chats/{chatId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidId(chatId);
        allow update, delete: if isOwner(userId) || isAdmin();
      }
    }

    // MARITIME PROJECTS
    // Anyone signed in can read projects (for expo attendees and staff)
    match /projects/{projectId} {
      allow read: if true; // Public read for expo showcase
      allow create: if isSignedIn() && isValidId(projectId) &&
        request.resource.data.id is string &&
        request.resource.data.name is string;
      allow update: if isSignedIn() && isValidId(projectId);
      allow delete: if isAdmin();
    }
  }
}
